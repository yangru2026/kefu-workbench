.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0f0f1a;
}

/* 周标签 */
.week-tabs {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: 10rpx 16rpx;
  background: #1a1a2e;
}

.week-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 110rpx;
  margin-right: 10rpx;
  border-radius: 16rpx;
  background: #16213e;
  transition: all 0.2s;
  position: relative;
}

.week-tab.active {
  background: linear-gradient(135deg, #ff6b35, #e55d2b);
  transform: scale(1.05);
}

.week-tab.today:not(.active) { border: 2rpx solid #ff6b35; }

.day-name { font-size: 26rpx; font-weight: 600; color: #ccc; }
.week-tab.active .day-name { color: #fff; }
.day-date { font-size: 20rpx; color: #888; margin-top: 4rpx; }
.week-tab.active .day-date { color: rgba(255,255,255,0.7); }

.done-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #2ecc71; margin-top: 6rpx; }

/* 内容区 */
.content { flex: 1; padding: 24rpx; }

/* 居家模板卡片 */
.home-template-list { display: flex; flex-direction: column; gap: 16rpx; }
.home-card {
  display: flex;
  align-items: center;
  background: #16213e;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
}
.home-icon { font-size: 44rpx; margin-right: 24rpx; }
.home-info { flex: 1; display: flex; flex-direction: column; }
.home-name { font-size: 32rpx; font-weight: 600; color: #fff; }
.home-sub { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.home-arrow { font-size: 40rpx; color: #666; }

/* 动作列表 */
.exercise-list { display: flex; flex-direction: column; gap: 24rpx; }

.ex-item { background: #16213e; border-radius: 20rpx; padding: 24rpx; }
.ex-header { display: flex; align-items: center; }

.ex-index {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #0f3460; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: #ff6b35; margin-right: 20rpx; flex-shrink: 0;
}
.ex-index.done { background: #2ecc71; color: #fff; }

.ex-info { flex: 1; display: flex; flex-direction: column; }
.ex-name { font-size: 30rpx; font-weight: 600; color: #fff; }
.ex-target { font-size: 24rpx; color: #888; margin-top: 4rpx; }

.ex-actions { flex-shrink: 0; }
.ex-delete { font-size: 28rpx; color: #e74c3c; padding: 10rpx; }

/* 视频按钮 */
.ex-video-btn {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #e55d2b);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-right: 12rpx;
}
.ex-video-btn text { font-size: 24rpx; color: #fff; }
.ex-video-btn:active { opacity: 0.7; transform: scale(0.95); }

/* 组详情 */
.sets-area { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #2a2a4a; }
.set-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.set-label { width: 90rpx; font-size: 24rpx; color: #888; flex-shrink: 0; }
.set-input {
  width: 120rpx; height: 60rpx; background: #0f3460; border-radius: 10rpx;
  text-align: center; font-size: 26rpx; color: #fff; margin: 0 8rpx;
}
.set-unit { font-size: 22rpx; color: #888; margin-right: 8rpx; }
.set-done { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #888; flex-shrink: 0; }
.set-done.checked { color: #2ecc71; }

.set-bar { display: flex; gap: 16rpx; margin-top: 12rpx; }
.btn-sm {
  background: transparent; border: 1rpx solid #2a2a4a; color: #ff6b35;
  border-radius: 8rpx; padding: 8rpx 20rpx; font-size: 22rpx; line-height: 1.4;
}
.btn-sm.danger { color: #e74c3c; border-color: #e74c3c; }

/* 添加动作 */
.add-section { margin: 32rpx 0; display: flex; justify-content: center; }
.add-btn { width: 100%; }

.finish-area { padding: 32rpx 0 60rpx; }
.btn-finish { width: 100%; }

/* 弹窗 */
.modal-list { max-height: 400rpx; margin-bottom: 20rpx; }
.modal-item {
  padding: 20rpx 24rpx; font-size: 28rpx; color: #ccc;
  border-radius: 12rpx; margin-bottom: 8rpx; background: #16213e;
  display: flex; justify-content: space-between; align-items: center;
}
.modal-item.selected { background: #ff6b35; color: #fff; }
.modal-item-equip { font-size: 22rpx; color: #666; }
.modal-item.selected .modal-item-equip { color: rgba(255,255,255,0.7); }

/* 搜索框 */
.search-input {
  height: 68rpx; background: #0f3460; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 26rpx; color: #fff; margin-bottom: 16rpx;
}

/* 分类筛选 */
.cat-filter { display: flex; white-space: nowrap; margin-bottom: 16rpx; }
.cat-chip {
  display: inline-block; padding: 10rpx 20rpx; border-radius: 20rpx;
  background: #16213e; font-size: 24rpx; color: #888; margin-right: 8rpx;
}
.cat-chip.active { background: #ff6b35; color: #fff; }

.modal-input-row { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.modal-input {
  flex: 1; height: 64rpx; background: #0f3460; border-radius: 10rpx;
  padding: 0 16rpx; font-size: 26rpx; color: #fff;
}
.modal-input.sm { flex: 0.5; }

/* 示范弹窗 */
.video-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.9); z-index: 200;
  display: flex; align-items: center; justify-content: center;
}
.video-box {
  width: 100%; max-height: 90vh; overflow-y: auto;
  display: flex; flex-direction: column; align-items: center; padding-bottom: 40rpx;
}
.video-header {
  width: 90%; display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; margin-bottom: 16rpx;
}
.video-title-row { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.video-title { font-size: 30rpx; font-weight: 600; color: #fff; }
.media-badge {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 16rpx; font-weight: 600;
}
.badge-video { background: rgba(255,107,53,0.2); color: #ff6b35; }
.badge-real { background: rgba(0,200,83,0.2); color: #00c853; }
.badge-3d { background: rgba(255,107,53,0.2); color: #ff6b35; }
.badge-gif { background: rgba(100,100,200,0.2); color: #8a8aff; }
.video-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255,255,255,0.15); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.demo-video { width: 90%; height: 520rpx; border-radius: 16rpx; background: #0f0f1a; }
.demo-image { width: 90%; height: 520rpx; border-radius: 16rpx; background: #0f0f1a; }
.equip-tag {
  font-size: 22rpx; color: #ff6b35; margin-top: 16rpx;
  background: rgba(255,107,53,0.1); padding: 8rpx 20rpx; border-radius: 8rpx;
}

/* 要点说明 */
.tips-section {
  width: 88%; margin-top: 24rpx; background: rgba(255,255,255,0.06);
  border-radius: 16rpx; border-left: 6rpx solid #ff6b35; padding: 24rpx 28rpx;
}
.tips-label { font-size: 26rpx; font-weight: 700; color: #ff6b35; margin-bottom: 14rpx; }
.tips-text { font-size: 24rpx; color: #ccc; line-height: 1.8; white-space: pre-line; }
