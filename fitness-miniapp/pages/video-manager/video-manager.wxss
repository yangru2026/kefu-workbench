.container {
  display: flex; flex-direction: column; height: 100vh; background: #0f0f1a;
}

/* 顶部统计卡片 */
.header-card {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 30rpx; margin: 20rpx; border-radius: 20rpx;
}
.header-title { font-size: 34rpx; font-weight: 700; color: #fff; }
.header-desc { font-size: 22rpx; color: #888; margin-top: 8rpx; }
.stat-row { display: flex; justify-content: space-around; margin-top: 24rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #fff; }
.stat-num.green { color: #00c853; }
.stat-num.orange { color: #ff6b35; }
.stat-num.blue { color: #8a8aff; }
.stat-label { font-size: 20rpx; color: #888; margin-top: 4rpx; }

/* 搜索栏 */
.search-bar { padding: 0 20rpx 10rpx; }
.search-input {
  background: #1a1a2e; border-radius: 16rpx; padding: 20rpx 30rpx;
  color: #fff; font-size: 28rpx;
}

/* 分类筛选 */
.cat-filter { white-space: nowrap; padding: 10rpx 20rpx; }
.cat-chip {
  display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx;
  border-radius: 30rpx; font-size: 24rpx; color: #888;
  background: #1a1a2e; border: 1rpx solid #2a2a3e;
}
.cat-chip.active { background: #ff6b35; color: #fff; border-color: #ff6b35; }

/* 动作列表 */
.exercise-list { flex: 1; padding: 10rpx 20rpx; }
.exercise-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #1a1a2e; border-radius: 16rpx; padding: 24rpx; margin-bottom: 12rpx;
}
.ex-info { flex: 1; }
.ex-name { font-size: 30rpx; font-weight: 600; color: #fff; }
.ex-tags { display: flex; gap: 12rpx; margin-top: 8rpx; }
.ex-tag {
  font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.08); color: #aaa;
}
.ex-status { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 12rpx; font-weight: 600; }
.ex-status.real { background: rgba(0,200,83,0.2); color: #00c853; }
.ex-status.video3d { background: rgba(255,107,53,0.2); color: #ff6b35; }
.ex-status.gif { background: rgba(100,100,200,0.2); color: #8a8aff; }

.ex-actions { display: flex; gap: 12rpx; }
.action-btn {
  padding: 12rpx 24rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600;
}
.btn-add { background: rgba(0,200,83,0.2); color: #00c853; }
.btn-edit { background: rgba(255,193,7,0.2); color: #ffc107; }
.btn-del { background: rgba(244,67,54,0.2); color: #f44336; padding: 12rpx 20rpx; }

.empty-tip { text-align: center; padding: 80rpx; color: #555; font-size: 28rpx; }
.bottom-space { height: 40rpx; }

/* 编辑弹窗 */
.edit-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.8); z-index: 999;
  display: flex; align-items: center; justify-content: center;
}
.edit-box {
  width: 90%; background: #1a1a2e; border-radius: 24rpx; padding: 36rpx;
  max-height: 80vh; overflow-y: auto;
}
.edit-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 30rpx;
}
.edit-title { font-size: 34rpx; font-weight: 700; color: #fff; }
.edit-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255,255,255,0.15); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.edit-preview {
  background: rgba(0,200,83,0.08); border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx;
}
.preview-label { font-size: 24rpx; color: #00c853; }
.preview-url { font-size: 22rpx; color: #666; word-break: break-all; margin-top: 8rpx; display: block; }

.input-section { margin-bottom: 30rpx; }
.input-label { font-size: 28rpx; font-weight: 600; color: #ccc; margin-bottom: 12rpx; display: block; }
.url-input {
  background: #0f0f1a; border-radius: 12rpx; padding: 24rpx;
  color: #fff; font-size: 26rpx; border: 1rpx solid #2a2a3e;
}
.input-hint { font-size: 22rpx; color: #555; margin-top: 8rpx; display: block; }

.upload-section { margin-bottom: 30rpx; }
.upload-btn {
  background: rgba(255,107,53,0.15); border: 1rpx dashed #ff6b35;
  border-radius: 12rpx; padding: 30rpx; text-align: center;
  color: #ff6b35; font-size: 28rpx; font-weight: 600;
}

.edit-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn-cancel {
  flex: 1; text-align: center; padding: 24rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.08); color: #888; font-size: 30rpx;
}
.btn-save {
  flex: 1; text-align: center; padding: 24rpx; border-radius: 12rpx;
  background: #ff6b35; color: #fff; font-size: 30rpx; font-weight: 600;
}
