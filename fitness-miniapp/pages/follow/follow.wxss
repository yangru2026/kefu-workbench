.container { display: flex; flex-direction: column; height: 100vh; background: #0f0f1a; }
.content { flex: 1; padding: 20rpx; }

/* 分类筛选 */
.type-filter { display: flex; white-space: nowrap; padding: 10rpx 0 20rpx; }
.type-chip {
  display: inline-block; padding: 12rpx 28rpx; border-radius: 24rpx;
  background: #16213e; font-size: 26rpx; color: #888; margin-right: 12rpx;
}
.type-chip.active { background: linear-gradient(135deg, #ff6b35, #e55d2b); color: #fff; }

/* 课程卡片 */
.course-list { display: flex; flex-direction: column; gap: 20rpx; }
.course-card { background: #16213e; border-radius: 20rpx; overflow: hidden; }
.course-card:active { opacity: 0.8; }
.course-top {
  height: 120rpx; display: flex; align-items: center; justify-content: space-between;
  padding: 0 28rpx;
}
.course-badge {
  background: rgba(255,255,255,0.25); color: #fff;
  padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; font-weight: 600;
}
.course-duration { color: #fff; font-size: 32rpx; font-weight: 700; }
.course-body { padding: 24rpx 28rpx; }
.course-name { font-size: 34rpx; font-weight: 700; color: #fff; display: block; }
.course-desc { font-size: 24rpx; color: #888; margin-top: 8rpx; display: block; }
.course-meta { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.meta-item { font-size: 24rpx; color: #aaa; }

/* B站原版视频按钮 */
.bili-btn {
  display: flex; align-items: center; margin-top: 20rpx;
  padding: 18rpx 24rpx; border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(251,114,153,0.15), rgba(255,107,53,0.1));
  border: 1rpx solid rgba(251,114,153,0.3);
}
.bili-btn:active { opacity: 0.7; transform: scale(0.98); }
.bili-icon { font-size: 32rpx; margin-right: 12rpx; }
.bili-text {
  flex: 1; font-size: 26rpx; font-weight: 600;
  color: #fb7299; /* B站粉 */
}
.bili-arrow { font-size: 32rpx; color: #fb7299; }

/* ===== 播放器 ===== */
.player { display: flex; flex-direction: column; height: 100vh; }

/* 进度条 */
.progress-bar { height: 6rpx; background: #2a2a4a; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #ff6b35, #f39c12); transition: width 1s linear; }

/* 准备阶段 */
.phase-prepare {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.prepare-label { font-size: 36rpx; color: #ccc; margin-bottom: 40rpx; }
.prepare-count {
  font-size: 180rpx; font-weight: 900; color: #ff6b35;
  animation: pulse 1s ease-in-out infinite;
}
.prepare-sub { font-size: 28rpx; color: #888; margin-top: 40rpx; }

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.7; }
}

/* 训练阶段 */
.phase-exercise {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 40rpx 24rpx; overflow-y: auto;
}
.phase-label {
  background: rgba(255,107,53,0.15); color: #ff6b35;
  padding: 8rpx 28rpx; border-radius: 20rpx; font-size: 26rpx; font-weight: 600;
}
.phase-label.rest { background: rgba(46,204,113,0.15); color: #2ecc71; }

.ex-name { font-size: 44rpx; font-weight: 700; color: #fff; margin-top: 20rpx; }

.countdown-big {
  font-size: 140rpx; font-weight: 900; color: #fff; line-height: 1.2;
}
.countdown-big.warning { color: #e74c3c; animation: shake 0.5s ease-in-out infinite; }
.countdown-unit { font-size: 32rpx; color: #888; }

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

.demo-gif {
  width: 400rpx; height: 400rpx; border-radius: 20rpx;
  background: #0f0f1a; margin: 30rpx 0;
}

.demo-video {
  width: 400rpx; height: 400rpx; border-radius: 20rpx;
  background: #0f0f1a; margin: 30rpx 0;
}

.demo-badge {
  display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx;
  border-radius: 16rpx; font-weight: 600; margin-top: 10rpx;
}
.demo-badge.video { background: rgba(255,107,53,0.2); color: #ff6b35; }
.demo-badge.real { background: rgba(0,200,83,0.2); color: #00c853; }
.demo-badge.gif { background: rgba(100,100,200,0.2); color: #8a8aff; }

.rest-icon { font-size: 120rpx; margin: 60rpx 0; }

/* 要点 */
.tips-box {
  width: 90%; background: rgba(255,255,255,0.06); border-radius: 16rpx;
  border-left: 6rpx solid #ff6b35; padding: 24rpx; margin-top: 20rpx;
}
.tips-label { font-size: 26rpx; font-weight: 700; color: #ff6b35; display: block; margin-bottom: 12rpx; }
.tips-text { font-size: 24rpx; color: #ccc; line-height: 1.8; white-space: pre-line; }

.ex-progress { font-size: 26rpx; color: #666; margin-top: 24rpx; }

/* 完成阶段 */
.phase-done {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 40rpx;
}
.done-icon { font-size: 120rpx; margin-bottom: 30rpx; }
.done-title { font-size: 48rpx; font-weight: 700; color: #fff; }
.done-sub { font-size: 28rpx; color: #888; margin-top: 12rpx; }
.done-stats { display: flex; gap: 40rpx; margin: 50rpx 0; }
.done-stat { display: flex; flex-direction: column; align-items: center; }
.done-stat-val { font-size: 44rpx; font-weight: 700; color: #ff6b35; }
.done-stat-label { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.done-btn { width: 400rpx; margin-top: 20rpx; }

/* 控制按钮 */
.controls {
  display: flex; gap: 16rpx; padding: 24rpx 32rpx 60rpx;
  background: #1a1a2e;
}
.ctrl-btn {
  flex: 1; background: #16213e; color: #fff; border: none;
  border-radius: 12rpx; padding: 24rpx 0; font-size: 28rpx;
}
.ctrl-btn.skip { color: #f39c12; }
.ctrl-btn.quit { color: #e74c3c; }
.ctrl-btn:active { opacity: 0.7; }
