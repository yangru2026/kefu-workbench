<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{stats.totalWorkouts}}</text>
      <text class="stat-label">总训练次数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.streak}}</text>
      <text class="stat-label">连续天数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.thisWeek}}</text>
      <text class="stat-label">本周训练</text>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="records-list" wx:if="{{records.length > 0}}">
    <view class="record-card" wx:for="{{records}}" wx:key="timestamp">
      <view class="record-header">
        <view class="record-meta">
          <text class="record-day">{{item.day}}</text>
          <text class="record-date">{{item.date}}</text>
        </view>
        <view class="record-toggle" bindtap="toggleExpand" data-idx="{{index}}">
          <text class="toggle-icon">{{item.expanded ? '▲' : '▼'}}</text>
        </view>
      </view>

      <!-- 展开动作详情 -->
      <view class="record-detail" wx:if="{{item.expanded}}">
        <view class="detail-ex" wx:for="{{item.exercises}}" wx:key="name" wx:for-item="ex">
          <view class="detail-header">
            <text class="detail-name">{{ex.name}}</text>
            <text class="detail-info">{{ex.setData.length}}组</text>
          </view>
          <view class="detail-sets">
            <block wx:for="{{ex.setData}}" wx:key="si" wx:for-item="sd" wx:for-index="si">
              <view class="detail-set-row">
                <text class="ds-label">第{{si + 1}}组</text>
                <text class="ds-value" wx:if="{{sd.weight}}">{{sd.weight}}kg</text>
                <text class="ds-value" wx:if="{{sd.reps}}">{{sd.reps}}次</text>
                <text class="ds-done">{{sd.done ? '✓' : '✗'}}</text>
              </view>
            </block>
          </view>
        </view>

        <button class="btn-outline del-btn" bindtap="deleteRecord" data-idx="{{index}}">删除此记录</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无训练记录</text>
    <text class="empty-sub">完成一次训练后这里会显示</text>
  </view>
</view>
