.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #0f0f1a;
}

/* 圆形计时器 */
.timer-circle {
  margin-bottom: 60rpx;
}

.circle-bg {
  width: 500rpx;
  height: 500rpx;
  position: relative;
}

/* 使用 clip-path 做圆环进度 */
.ring-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  border: 20rpx solid #16213e;
}

.ring-fill {
  position: absolute;
  top: -20rpx; left: -20rpx; right: -20rpx; bottom: -20rpx;
  border-radius: 50%;
  border: 20rpx solid transparent;
  border-top-color: #ff6b35;
  border-right-color: #ff6b35;
  transform: rotate(-45deg);
  clip: rect(0, 540rpx, 540rpx, 270rpx);
  transition: none;
}

.circle-inner {
  position: absolute;
  top: 40rpx; left: 40rpx; right: 40rpx; bottom: 40rpx;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.timer-display {
  font-size: 100rpx;
  font-weight: 300;
  color: #fff;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
}

.timer-state {
  font-size: 28rpx;
  color: #888;
  margin-top: 12rpx;
}

.timer-state.done { color: #2ecc71; }

/* 预设按钮 */
.presets {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  width: 100%;
  justify-content: center;
}

.preset {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: #16213e;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.preset.active {
  border-color: #ff6b35;
  background: rgba(255, 107, 53, 0.15);
}

.preset-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.preset-sec {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.ctrl-btn {
  width: 240rpx;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.ctrl-btn.start {
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: #fff;
}

.ctrl-btn.start.pause {
  background: linear-gradient(135deg, #f39c12, #e67e22);
}

.ctrl-btn.reset {
  background: transparent;
  border: 2rpx solid #2a2a4a;
  color: #ccc;
}

/* 自定义 */
.custom-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.custom-input {
  width: 280rpx;
  height: 72rpx;
  background: #16213e;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
}

.btn-sm {
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
}
